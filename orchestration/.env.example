# Local development only. On Astronomer set these as deployment environment variables.
ENV_NAME=dev

# Read Airflow connections from Azure Key Vault. Secret name = prefix + conn id, underscores become hyphens:
#   conn id databricks_default -> secret airflow-connections-databricks-default
AIRFLOW__SECRETS__BACKEND=airflow.providers.microsoft.azure.secrets.key_vault.AzureKeyVaultBackend
AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_prefix": "airflow-connections", "vault_url": "https://<your-keyvault>.vault.azure.net/", "sep": "-"}

# Value of the Key Vault secret airflow-connections-databricks-default (service principal, OAuth M2M):
# {"conn_type":"databricks","host":"https://adb-<id>.<n>.azuredatabricks.net","login":"<sp-client-id>","password":"<sp-oauth-secret>","extra":{"service_principal_oauth":true}}
#
# Secretless alternative (workload identity on the deployment):
# {"conn_type":"databricks","host":"https://adb-<id>.<n>.azuredatabricks.net","extra":{"use_default_azure_credential":true}}
